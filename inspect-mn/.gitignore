# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# L1 local auth fixture / temp SQL (never commit)
scripts/.l1-*
scripts/*.fixture.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Policy SSR local fixtures
scripts/.policy-ssr-local.fixture.json
scripts/.l1-local-auth.fixture.json
scripts/.l1-seed-profile.tmp.sql

