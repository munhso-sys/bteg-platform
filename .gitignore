# Root .gitignore for monorepo
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build outputs
.next/
out/
build/

# turbopack
.turbo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files
.env*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# test coverage
coverage/

# Playwright / local gate artifacts
test-results/
playwright-report/
docs/prod-audit/*.log
docs/prod-audit/e2e-server-*.log
docs/prod-audit/e2e-last-run.json

# local runtime data
data/
*.tmp

# misc
*.pem
*.sst
*.node

# Never commit plaintext Vercel / API token dumps
bgs-policy-compliance/vercel token.txt
**/vercel token.txt